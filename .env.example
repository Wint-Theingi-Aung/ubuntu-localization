# Google Gemini API key for AI translation
GOOGLE_API_KEY=your_gemini_api_key_here

# Neon PostgreSQL connection string (for authentication, glossary, history)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Launchpad OAuth consumer key (for user authentication via Launchpad)
# Must be in "System-wide: {distro} ({hostname})" format (matches launchpadlib).
# Auto-generated from /etc/os-release + hostname if not set.
# LAUNCHPAD_CONSUMER_KEY=System-wide: Ubuntu (ycdc)

# Session secret (random string for session token generation)
SESSION_SECRET=generate_a_random_string_here
