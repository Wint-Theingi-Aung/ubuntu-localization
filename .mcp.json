{
  "mcpServers": {
    "launchpad-bridge": {
      "command": "bash",
      "args": [".claude/mcp-servers/launchpad-bridge/run.sh"]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost:5432/ubuntu_localization"
      ]
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        ".",
        "/tmp/ubuntu-localization"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "caveman": {
      "command": "npx",
      "args": [
        "-y",
        "caveman-mcp"
      ]
    }
  }
}
