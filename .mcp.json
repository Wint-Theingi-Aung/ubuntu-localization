{
  "mcpServers": {
    "github": {
      "command": "/home/wint/.claude/mcp-servers/github-server.sh",
      "args": []
    },
    "launchpad-bridge": {
      "command": "/home/wint/.claude/mcp-servers/launchpad-bridge/run.sh",
      "args": []
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost:5432/ubuntu_localization"
      ]
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/wint/ubuntu-localization",
        "/tmp/ubuntu-localization"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "caveman": {
      "command": "npx",
      "args": [
        "-y",
        "caveman-mcp"
      ]
    }
  }
}
